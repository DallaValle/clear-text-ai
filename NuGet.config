<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin restore to nuget.org so private feeds inherited from the machine config
       cannot break or slow down a clean clone. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
