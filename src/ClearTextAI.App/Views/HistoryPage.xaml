<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ClearTextAI.Core.Models;assembly=ClearTextAI.Core"
             xmlns:viewmodels="clr-namespace:ClearTextAI.Core.ViewModels;assembly=ClearTextAI.Core"
             x:Class="ClearTextAI.App.Views.HistoryPage"
             x:DataType="viewmodels:HistoryViewModel"
             Title="History">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <!-- The Shell navigation bar renders the page title, so only the subtitle belongs here. -->
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="Stored on this machine only." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Clear all"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center"
                    Command="{Binding ClearAllCommand}" />
        </Grid>

        <Label Grid.Row="1"
               Text="Nothing here yet. Improved text shows up once you use Improve Text."
               Style="{StaticResource Muted}"
               IsVisible="{Binding IsEmpty}"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RewriteHistoryItem">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding CreatedAt, StringFormat='{0:g}'}"
                                       Style="{StaticResource Muted}" />
                                <Label Grid.Column="1" Text="{Binding Model}" Style="{StaticResource Muted}" />
                            </Grid>

                            <Label Text="{Binding OriginalText}" MaxLines="3" LineBreakMode="TailTruncation" Style="{StaticResource Muted}" />
                            <Label Text="{Binding RewrittenText}" MaxLines="6" LineBreakMode="TailTruncation" />

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Copy"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistoryViewModel}}, Path=CopyCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="Delete"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistoryViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="2"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding HasStatus}"
               Style="{StaticResource Muted}" />
    </Grid>
</ContentPage>
